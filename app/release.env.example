# Copy to release.env (gitignored). build-app.sh and release.sh read it.
# Nothing here is secret: private keys stay in the Keychain or CI secrets.

# Update feed: https://<your site>/updates/appcast.xml, and the public key from
# .build/artifacts/sparkle/Sparkle/bin/generate_keys
SPARKLE_FEED_URL=
SPARKLE_PUBLIC_KEY=

# Links shown in Settings → About and used for feedback. The tip jar opens <website>/tip.
PORTO_REPOSITORY=
PORTO_WEBSITE=

# Developer ID signing and notarization (optional; ad-hoc signing without them).
CODE_SIGN_IDENTITY=
NOTARYTOOL_PROFILE=
